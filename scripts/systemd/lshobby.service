# LSHobby 상시 로컬 호스팅 — 이 PC가 프로덕션이다 (docs/16 §16.5).
# 배포는 lshobby-deploy.timer가 한다. 손으로 올리려면 DEPLOY_SKIP_CI=1 scripts/deploy-local.sh
[Unit]
Description=LSHobby (next start)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/leesongheon/projects/LSHobby
# nvm은 로그인 셸에서만 PATH를 잡아 준다 — 서비스에는 절대 경로를 직접 준다
Environment=PATH=/home/leesongheon/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
# 루프백에만 바인드 — 밖에서는 tailscale 사이드카(serve :443 → 127.0.0.1:3000)로만 들어온다.
# 기본값(0.0.0.0)이면 LAN에서 평문 HTTP로 tailnet을 건너뛰고 닿는다
ExecStart=/home/leesongheon/.nvm/versions/node/v24.19.0/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
